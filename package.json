{
  "name": "atelier452-magic",
  "version": "1.0.0",
  "private": true,
  "description": "Atelier452 Magic — 关键帧中割生成 + 视频转绘上色（Seedance）",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atelier452.magic",
    "productName": "Atelier452 Magic",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.js",
      "public-mode.js",
      "public/**",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Atelier452Magic.exe"
    }
  }
}
